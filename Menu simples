-------------------------------------------------------------------------
-- LÓGICA DE REDIMENSIONAR (RESIZE) ESTILO SIGMA SPY
-------------------------------------------------------------------------
local function makeResizable(handle, object)
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startSize

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startSize = object.Size
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local newSizeX = startSize.X.Offset + delta.X
            local newSizeY = startSize.Y.Offset + delta.Y
            
            -- Limites mínimos para não sumir a UI
            if newSizeX < 250 then newSizeX = 250 end
            if newSizeY < 150 then newSizeY = 150 end
            
            object.Size = UDim2.new(0, newSizeX, 0, newSizeY)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
makeResizable(ResizeHandle, MainFrame)

